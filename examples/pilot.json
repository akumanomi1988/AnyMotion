      "dialogue": [
        { "lineId": "DL001", "characterId": "leo", "startMs": 800, "endMs": 4550, "text": "He resuelto el problema de las contraseñas de casa." },
        { "lineId": "DL002", "characterId": "vera", "startMs": 5350, "endMs": 7800, "text": "¿Qué problema?" },
        { "lineId": "DL003", "characterId": "leo", "startMs": 8950, "endMs": 14300, "text": "Que siempre las olvidamos. He diseñado un protocolo familiar." },
        { "lineId": "DL004", "characterId": "vera", "startMs": 15450, "endMs": 19800, "text": "Leo, es la contraseña del wifi, no la de un submarino nuclear." },
        { "lineId": "DL005", "characterId": "leo", "startMs": 20900, "endMs": 26100, "text": "Precisamente. Cada dispositivo tendrá su nivel de acceso." },
        { "lineId": "DL006", "characterId": "vera", "startMs": 27400, "endMs": 31700, "text": "¿Y dónde se apunta la contraseña principal?" },
        { "lineId": "DL007", "characterId": "leo", "startMs": 32900, "endMs": 36100, "text": "En un archivo protegido con otra contraseña." }
      ]
    },
