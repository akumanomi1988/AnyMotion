      "dialogue": [
        { "lineId": "DL008", "characterId": "vera", "startMs": 38500, "endMs": 42700, "text": "A ver si lo entiendo. Para entrar al wifi, necesito una clave." },
        { "lineId": "DL009", "characterId": "leo", "startMs": 43900, "endMs": 49900, "text": "Primero, autenticarte. Después recibes un código temporal." },
        { "lineId": "DL010", "characterId": "vera", "startMs": 51000, "endMs": 56000, "text": "¿Y el código cómo llega si no tengo wifi?" },
        { "lineId": "DL011", "characterId": "leo", "startMs": 57900, "endMs": 62400, "text": "Por correo electrónico. Es un sistema muy seguro." },
        { "lineId": "DL012", "characterId": "vera", "startMs": 63700, "endMs": 68300, "text": "Me voy a casa de mi madre. Allí solo hay una contraseña." },
        { "lineId": "DL013", "characterId": "leo", "startMs": 69300, "endMs": 73900, "text": "¿Me la puedes pedir? Es para la actualización del protocolo." },
        { "lineId": "DL014", "characterId": "vera", "startMs": 75600, "endMs": 77500, "text": "No." }
