      ],
      "dialogue": [
        {
          "lineId": "DL082",
          "characterId": "leo",
          "startMs": 486200,
          "endMs": 491600,
          "text": "Ya está. Ventana cerrada, calefacción estable, sensores desconectados."
        },
        {
          "lineId": "DL083",
          "characterId": "vera",
          "startMs": 492200,
          "endMs": 497600,
          "text": "Qué tranquilidad. Me había olvidado de lo agradable que es no medir nada."
        },
        {
          "lineId": "DL084",
          "characterId": "leo",
          "startMs": 498200,
          "endMs": 503600,
          "text": "Hasta la planta parece más contenta. Y eso que no tiene opinión."
        },
        {
          "lineId": "DL085",
          "characterId": "vera",
          "startMs": 504200,
          "endMs": 509600,
          "text": "Le he puesto un cartel: zona climática independiente y feliz."
        },
        {
          "lineId": "DL086",
          "characterId": "leo",
          "startMs": 510200,
          "endMs": 515600,
          "text": "¿No habíamos quedado en dejar de crear países dentro del piso?"
        },
        {
          "lineId": "DL087",
          "characterId": "vera",
          "startMs": 516200,
          "endMs": 521600,
          "text": "Solo es una república vegetal. No necesita presupuesto ni funcionarios."
        },
        {
          "lineId": "DL088",
          "characterId": "leo",
          "startMs": 522200,
          "endMs": 527600,
          "text": "Mañana le pones una aduana y acabamos pagando impuestos por regarla."
        },
        {
          "lineId": "DL089",
          "characterId": "vera",
          "startMs": 528200,
          "endMs": 533600,
          "text": "No seas exagerada. Las aduanas las había reservado para los calcetines."
        },
        {
          "lineId": "DL090",
          "characterId": "leo",
          "startMs": 534200,
          "endMs": 539600,
          "text": "Ven aquí, ministro del invierno. Te voy a confiscar una manta."
        }
      ]
    }
