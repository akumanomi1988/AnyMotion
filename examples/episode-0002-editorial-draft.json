      ],
      "dialogue": [
        {
          "lineId": "DL019",
          "characterId": "leo",
          "startMs": 108200,
          "endMs": 113600,
          "text": "Propongo votarlo: tú eliges veintiuno, yo elijo veintitrés."
        },
        {
          "lineId": "DL020",
          "characterId": "vera",
          "startMs": 114200,
          "endMs": 119600,
          "text": "Solo somos dos. Eso no es una votación; es un empate con radiadores."
        },
        {
          "lineId": "DL021",
          "characterId": "leo",
          "startMs": 120200,
          "endMs": 125600,
          "text": "Podemos darle un voto al sofá. Es quien más tiempo pasa aquí."
        },
        {
          "lineId": "DL022",
          "characterId": "vera",
          "startMs": 126200,
          "endMs": 131600,
          "text": "El sofá está tapizado. Siempre votará por el calor, no es imparcial."
        },
        {
          "lineId": "DL023",
          "characterId": "leo",
          "startMs": 132200,
          "endMs": 137600,
          "text": "Entonces vota la planta. Lleva meses sufriendo nuestros desacuerdos."
        },
        {
          "lineId": "DL024",
          "characterId": "vera",
          "startMs": 138200,
          "endMs": 143600,
          "text": "La planta es de plástico. Su opinión medioambiental está bastante comprometida."
        },
        {
          "lineId": "DL025",
          "characterId": "leo",
          "startMs": 144200,
          "endMs": 149600,
          "text": "Podemos usar un algoritmo que calcule un compromiso aceptable."
        },
        {
          "lineId": "DL026",
          "characterId": "vera",
          "startMs": 150200,
          "endMs": 155600,
          "text": "El compromiso entre veintiuno y veintitrés es veintidós. Lo estudiamos ayer."
        },
        {
          "lineId": "DL027",
          "characterId": "leo",
          "startMs": 156200,
          "endMs": 161600,
          "text": "Sí, pero ayer no teníamos un algoritmo que cobrara honorarios."
        }
      ]
    },
