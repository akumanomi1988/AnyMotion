        {
          "id": "AC071",
          "type": "gesture",
          "actorId": "leo",
          "gesture": "point",
          "atMs": 248000,
          "durationMs": 1800
        }
      ],
      "dialogue": [
        {
          "lineId": "DL037",
          "characterId": "leo",
          "startMs": 216200,
          "endMs": 221600,
          "text": "He preparado una aplicación que registra temperatura y humedad cada minuto."
        },
        {
          "lineId": "DL038",
          "characterId": "vera",
          "startMs": 222200,
          "endMs": 227600,
          "text": "¿No era más sencillo ponernos una sudadera si teníamos frío?"
        },
        {
          "lineId": "DL039",
          "characterId": "leo",
          "startMs": 228200,
          "endMs": 233600,
          "text": "Eso no escala. Mi sistema tiene gráficos y alertas inteligentes."
        },
        {
          "lineId": "DL040",
          "characterId": "vera",
          "startMs": 234200,
          "endMs": 239600,
          "text": "¿Por qué acaba de avisarme de una emergencia climática?"
        },
        {
          "lineId": "DL041",
          "characterId": "leo",
          "startMs": 240200,
          "endMs": 245600,
          "text": "El sensor de humedad está encima de la olla que hierve."
        },
        {
          "lineId": "DL042",
          "characterId": "vera",
          "startMs": 246200,
          "endMs": 251600,
          "text": "El sistema cree que la cocina atraviesa un monzón."
        },
        {
          "lineId": "DL043",
          "characterId": "leo",
          "startMs": 252200,
          "endMs": 257600,
          "text": "Entonces le pondré un paraguas al sensor y normalizamos el dato."
        },
        {
          "lineId": "DL044",
          "characterId": "vera",
          "startMs": 258200,
          "endMs": 263600,
          "text": "No le pongas paraguas a un termómetro. Quítalo de la olla."
        },
        {
          "lineId": "DL045",
          "characterId": "leo",
          "startMs": 264200,
          "endMs": 269600,
          "text": "Anoto una incidencia: el departamento de operaciones rechaza la innovación."
        }
      ]
    },
