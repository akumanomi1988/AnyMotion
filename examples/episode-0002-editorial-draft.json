        },
        {
          "id": "AC091",
          "type": "gesture",
          "actorId": "leo",
          "gesture": "point",
          "atMs": 464000,
          "durationMs": 1800
        }
      ],
      "dialogue": [
        {
          "lineId": "DL073",
          "characterId": "vera",
          "startMs": 432200,
          "endMs": 437600,
          "text": "Voy a cerrar la ventana y tú vas a desconectar los sensores."
        },
        {
          "lineId": "DL074",
          "characterId": "leo",
          "startMs": 438200,
          "endMs": 443600,
          "text": "De acuerdo. Pero quiero guardar el gráfico final como recuerdo."
        },
        {
          "lineId": "DL075",
          "characterId": "vera",
          "startMs": 444200,
          "endMs": 449600,
          "text": "Puedes guardarlo. Solo no lo conviertas en una presentación familiar."
        },
        {
          "lineId": "DL076",
          "characterId": "leo",
          "startMs": 450200,
          "endMs": 455600,
          "text": "¿Y si hacemos una diapositiva con los errores y aprendizajes?"
        },
        {
          "lineId": "DL077",
          "characterId": "vera",
          "startMs": 456200,
          "endMs": 461600,
          "text": "La primera diapositiva sería una ventana abierta en noviembre."
        },
        {
          "lineId": "DL078",
          "characterId": "leo",
          "startMs": 462200,
          "endMs": 467600,
          "text": "La segunda, dos adultos que prefieren debatir antes que comprobar."
        },
        {
          "lineId": "DL079",
          "characterId": "vera",
          "startMs": 468200,
          "endMs": 473600,
          "text": "La tercera debería mostrar que todavía podemos reírnos de nosotros."
        },
        {
          "lineId": "DL080",
          "characterId": "leo",
          "startMs": 474200,
          "endMs": 479600,
          "text": "Esa me gusta. Incluso pondría una foto nuestra con la manta."
        },
        {
          "lineId": "DL081",
          "characterId": "vera",
          "startMs": 480200,
          "endMs": 485600,
          "text": "Perfecto, mientras no necesite contraseña para acceder a la foto."
        }
      ]
    },
