      ],
      "dialogue": [
        {
          "lineId": "DL001",
          "characterId": "vera",
          "startMs": 200,
          "endMs": 5600,
          "text": "¿Has tocado la calefacción? La casa acaba de pasar de otoño a desierto."
        },
        {
          "lineId": "DL002",
          "characterId": "leo",
          "startMs": 6200,
          "endMs": 11600,
          "text": "La he puesto a veintidós. Es una temperatura científicamente civilizada."
        },
        {
          "lineId": "DL003",
          "characterId": "vera",
          "startMs": 12200,
          "endMs": 17600,
          "text": "Mi pie izquierdo opina que estamos en el polo norte."
        },
        {
          "lineId": "DL004",
          "characterId": "leo",
          "startMs": 18200,
          "endMs": 23600,
          "text": "Tu pie izquierdo lleva calcetín de verano en noviembre. No tiene voto."
        },
        {
          "lineId": "DL005",
          "characterId": "vera",
          "startMs": 24200,
          "endMs": 29600,
          "text": "Entonces mi pie derecho solicita una segunda lectura independiente."
        },
        {
          "lineId": "DL006",
          "characterId": "leo",
          "startMs": 30200,
          "endMs": 35600,
          "text": "Hagamos una cosa: ninguno toca la calefacción sin avisar al otro."
        },
        {
          "lineId": "DL007",
          "characterId": "vera",
          "startMs": 36200,
          "endMs": 41600,
          "text": "Perfecto. ¿Avisar incluye dejar una nota encima del termostato?"
        },
        {
          "lineId": "DL008",
          "characterId": "leo",
          "startMs": 42200,
          "endMs": 47600,
          "text": "Incluye decirlo. Con palabras. Mirándome a la cara, si puede ser."
        },
        {
          "lineId": "DL009",
          "characterId": "vera",
          "startMs": 48200,
          "endMs": 53600,
          "text": "Entendido. Te informo oficialmente de que voy a subir un grado."
        }
      ]
    },
