          "durationMs": 1800
        }
      ],
      "dialogue": [
        {
          "lineId": "DL028",
          "characterId": "leo",
          "startMs": 162200,
          "endMs": 167600,
          "text": "He diseñado tres zonas de confort: salón templado, cocina neutra, dormitorio fresco."
        },
        {
          "lineId": "DL029",
          "characterId": "vera",
          "startMs": 168200,
          "endMs": 173600,
          "text": "¿Y esa cinta adhesiva cruzando el pasillo?"
        },
        {
          "lineId": "DL030",
          "characterId": "leo",
          "startMs": 174200,
          "endMs": 179600,
          "text": "Es la frontera entre dos microclimas. No pases sin aclimatarte."
        },
        {
          "lineId": "DL031",
          "characterId": "vera",
          "startMs": 180200,
          "endMs": 185600,
          "text": "Leo, estás usando la misma calefacción para toda la casa."
        },
        {
          "lineId": "DL032",
          "characterId": "leo",
          "startMs": 186200,
          "endMs": 191600,
          "text": "Por eso las fronteras son simbólicas. Generan sensación de control."
        },
        {
          "lineId": "DL033",
          "characterId": "vera",
          "startMs": 192200,
          "endMs": 197600,
          "text": "La cinta está pegada a mis zapatillas. Ahora tengo doble nacionalidad."
        },
        {
          "lineId": "DL034",
          "characterId": "leo",
          "startMs": 198200,
          "endMs": 203600,
          "text": "Podríamos crear pasaportes térmicos y sellarlos al entrar."
        },
        {
          "lineId": "DL035",
          "characterId": "vera",
          "startMs": 204200,
          "endMs": 209600,
          "text": "Podríamos crear una sola norma: quitar la cinta del suelo."
        },
        {
          "lineId": "DL036",
          "characterId": "leo",
          "startMs": 210200,
          "endMs": 215600,
          "text": "Vale, pero el dormitorio conserva su independencia hasta nueva reunión."
        }
      ]
    },
