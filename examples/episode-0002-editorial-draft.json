          "expression": "thinking",
          "atMs": 423000
        },
        {
          "id": "AC086",
          "type": "gesture",
          "actorId": "vera",
          "gesture": "raiseHand",
          "atMs": 410000,
          "durationMs": 1800
        }
      ],
      "dialogue": [
        {
          "lineId": "DL064",
          "characterId": "leo",
          "startMs": 378200,
          "endMs": 383600,
          "text": "Puede que tengas razón. He convertido un grado en una guerra territorial."
        },
        {
          "lineId": "DL065",
          "characterId": "vera",
          "startMs": 384200,
          "endMs": 389600,
          "text": "Y yo he defendido el termostato como si fuera una frontera nacional."
        },
        {
          "lineId": "DL066",
          "characterId": "leo",
          "startMs": 390200,
          "endMs": 395600,
          "text": "Pacto de paz: veintidós grados y derecho a usar sudadera."
        },
        {
          "lineId": "DL067",
          "characterId": "vera",
          "startMs": 396200,
          "endMs": 401600,
          "text": "Con una condición: nadie vuelve a votar con la planta."
        },
        {
          "lineId": "DL068",
          "characterId": "leo",
          "startMs": 402200,
          "endMs": 407600,
          "text": "Aceptado. Además, desde aquí parece que ya se nota el calor."
        },
        {
          "lineId": "DL069",
          "characterId": "vera",
          "startMs": 408200,
          "endMs": 413600,
          "text": "Un momento. ¿Por qué se mueve esa cortina si todo está cerrado?"
        },
        {
          "lineId": "DL070",
          "characterId": "leo",
          "startMs": 414200,
          "endMs": 419600,
          "text": "La ventana está entreabierta. La abrí para ventilar esta mañana."
        },
        {
          "lineId": "DL071",
          "characterId": "vera",
          "startMs": 420200,
          "endMs": 425600,
          "text": "¿Has discutido conmigo dos horas por una ventana abierta?"
        },
        {
          "lineId": "DL072",
          "characterId": "leo",
          "startMs": 426200,
          "endMs": 431600,
          "text": "No exactamente. Hemos avanzado mucho en cooperación y ciencia."
        }
      ]
    },
    {
