      ],
      "dialogue": [
        {
          "lineId": "DL010",
          "characterId": "vera",
          "startMs": 54200,
          "endMs": 59600,
          "text": "Te he dicho que avises, no que conviertas el aviso en una provocación."
        },
        {
          "lineId": "DL011",
          "characterId": "leo",
          "startMs": 60200,
          "endMs": 65600,
          "text": "No discuto: voy a colocar termómetros y aceptaré los hechos."
        },
        {
          "lineId": "DL012",
          "characterId": "vera",
          "startMs": 66200,
          "endMs": 71600,
          "text": "¿Por qué hay uno dentro del bote del café?"
        },
        {
          "lineId": "DL013",
          "characterId": "leo",
          "startMs": 72200,
          "endMs": 77600,
          "text": "Es una zona representativa de nuestra actividad cotidiana por la mañana."
        },
        {
          "lineId": "DL014",
          "characterId": "vera",
          "startMs": 78200,
          "endMs": 83600,
          "text": "El café está a sesenta grados. Según tu informe, vivimos en un volcán."
        },
        {
          "lineId": "DL015",
          "characterId": "leo",
          "startMs": 84200,
          "endMs": 89600,
          "text": "Bien visto. Deberíamos descartar los datos que tengan cafeína."
        },
        {
          "lineId": "DL016",
          "characterId": "vera",
          "startMs": 90200,
          "endMs": 95600,
          "text": "También has puesto un termómetro al lado del horno encendido."
        },
        {
          "lineId": "DL017",
          "characterId": "leo",
          "startMs": 96200,
          "endMs": 101600,
          "text": "Ese es el control positivo. Un experimento serio necesita extremos."
        },
        {
          "lineId": "DL018",
          "characterId": "vera",
          "startMs": 102200,
          "endMs": 107600,
          "text": "Tu experimento confirma que el horno calienta. Enhorabuena, doctor invierno."
        }
      ]
    },
