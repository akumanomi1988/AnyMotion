          "type": "setExpression",
          "actorId": "vera",
          "expression": "surprised",
          "atMs": 347000
        },
        {
          "id": "AC034",
          "type": "setExpression",
          "actorId": "vera",
          "expression": "happy",
          "atMs": 358000
        },
        {
          "id": "AC035",
          "type": "setExpression",
          "actorId": "vera",
          "expression": "skeptical",
          "atMs": 369000
        },
        {
          "id": "AC081",
          "type": "gesture",
          "actorId": "leo",
          "gesture": "crossArms",
          "atMs": 356000,
          "durationMs": 1800
        }
      ],
      "dialogue": [
        {
          "lineId": "DL055",
          "characterId": "vera",
          "startMs": 324200,
          "endMs": 329600,
          "text": "Hagamos una prueba: apagamos las pantallas y nos tapamos con una manta."
        },
        {
          "lineId": "DL056",
          "characterId": "leo",
          "startMs": 330200,
          "endMs": 335600,
          "text": "Acepto, siempre que registremos la temperatura antes y después."
        },
        {
          "lineId": "DL057",
          "characterId": "vera",
          "startMs": 336200,
          "endMs": 341600,
          "text": "La manta es de cuadros. No necesita un panel de estadísticas."
        },
        {
          "lineId": "DL058",
          "characterId": "leo",
          "startMs": 342200,
          "endMs": 347600,
          "text": "Quiero demostrar que una solución simple puede superar a una compleja."
        },
        {
          "lineId": "DL059",
          "characterId": "vera",
          "startMs": 348200,
          "endMs": 353600,
          "text": "Esa frase sería preciosa si no hubieras necesitado tres días para decirla."
        },
        {
          "lineId": "DL060",
          "characterId": "leo",
          "startMs": 354200,
          "endMs": 359600,
          "text": "No han sido tres días. Solo cuarenta y ocho horas y nueve minutos."
        },
        {
          "lineId": "DL061",
          "characterId": "vera",
          "startMs": 360200,
          "endMs": 365600,
          "text": "Ahora estás contando el tiempo que llevas defendiendo una manta."
        },
        {
          "lineId": "DL062",
          "characterId": "leo",
          "startMs": 366200,
          "endMs": 371600,
          "text": "Es el primer dato verdaderamente útil de toda la investigación."
        },
        {
          "lineId": "DL063",
          "characterId": "vera",
          "startMs": 372200,
          "endMs": 377600,
          "text": "Entonces escribe la conclusión: Vera tenía razón esta vez."
        }
      ]
    },
    {
