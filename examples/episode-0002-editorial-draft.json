        }
      ],
      "dialogue": [
        {
          "lineId": "DL046",
          "characterId": "vera",
          "startMs": 270200,
          "endMs": 275600,
          "text": "Tu aplicación dice que hemos gastado veinte euros en sensores."
        },
        {
          "lineId": "DL047",
          "characterId": "leo",
          "startMs": 276200,
          "endMs": 281600,
          "text": "Es una inversión. A largo plazo sabremos ahorrar calefacción."
        },
        {
          "lineId": "DL048",
          "characterId": "vera",
          "startMs": 282200,
          "endMs": 287600,
          "text": "¿Y cuánto hemos ahorrado desde que empezaste tu estudio?"
        },
        {
          "lineId": "DL049",
          "characterId": "leo",
          "startMs": 288200,
          "endMs": 293600,
          "text": "Todavía no se puede medir. El periodo de observación es insuficiente."
        },
        {
          "lineId": "DL050",
          "characterId": "vera",
          "startMs": 294200,
          "endMs": 299600,
          "text": "También has comprado una tableta para consultar las temperaturas."
        },
        {
          "lineId": "DL051",
          "characterId": "leo",
          "startMs": 300200,
          "endMs": 305600,
          "text": "Era necesaria. El móvil me daba una perspectiva demasiado pequeña."
        },
        {
          "lineId": "DL052",
          "characterId": "vera",
          "startMs": 306200,
          "endMs": 311600,
          "text": "Con lo que has gastado podríamos calentar el piso toda la semana."
        },
        {
          "lineId": "DL053",
          "characterId": "leo",
          "startMs": 312200,
          "endMs": 317600,
          "text": "Es cierto, pero no tendríamos esta información tan completa."
        },
        {
          "lineId": "DL054",
          "characterId": "vera",
          "startMs": 318200,
          "endMs": 323600,
          "text": "La información principal es que tenemos frío y menos dinero."
        }
      ]
    },
