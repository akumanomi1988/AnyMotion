# Never commit real credentials, and never expose this file outside the local operator machine.
# OpenAI-compatible structured LLM (HTTPS or loopback HTTP only)
ANYMOTION_LLM_ENDPOINT=
ANYMOTION_LLM_MODEL=
ANYMOTION_LLM_API_KEY=

# Optional TTS: an OpenAI-compatible /v1/audio/speech endpoint returning WAV.
# Do not rely on unreviewed voices for release. The service and voice models are installed separately.
ANYMOTION_TTS_ENDPOINT=
ANYMOTION_TTS_MODEL=
ANYMOTION_TTS_API_KEY=
# Example shape (replace voice IDs with installed, licensed model voices):
# ANYMOTION_TTS_VOICES={"es-ES":{"vera":"...","leo":"..."},"en-US":{"vera":"...","leo":"..."}}

# Official YouTube Data API OAuth, required only for an explicitly confirmed PRIVATE upload.
# Option A: a short-lived access token
ANYMOTION_YOUTUBE_ACCESS_TOKEN=
# Option B: refresh token obtained with the user's authorized OAuth flow
ANYMOTION_YOUTUBE_CLIENT_ID=
ANYMOTION_YOUTUBE_CLIENT_SECRET=
ANYMOTION_YOUTUBE_REFRESH_TOKEN=
