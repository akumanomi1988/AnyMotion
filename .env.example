# Copy locally to .env if needed; the program does not automatically load .env files.
# Never commit actual credentials. Use the host environment or a secrets manager.
ANYMOTION_LLM_ENDPOINT=https://your-llm-provider.example/v1/chat/completions
ANYMOTION_LLM_MODEL=your-model
ANYMOTION_LLM_API_KEY=
ANYMOTION_TTS_ENDPOINT=http://127.0.0.1:8888/v1/audio/speech
ANYMOTION_TTS_MODEL=your-voice-model
ANYMOTION_TTS_VOICES={"es-ES":{"vera":"es_female","leo":"es_male"},"en-US":{"vera":"en_female","leo":"en_male"}}
ANYMOTION_TTS_API_KEY=
ANYMOTION_APPROVED_VOICE_PROVIDERS=
ANYMOTION_YOUTUBE_CLIENT_ID=
ANYMOTION_YOUTUBE_CLIENT_SECRET=
ANYMOTION_YOUTUBE_REFRESH_TOKEN=
# Alternative transient OAuth token for diagnosis only:
ANYMOTION_YOUTUBE_ACCESS_TOKEN=
